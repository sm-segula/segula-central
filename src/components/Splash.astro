---
/**
 * Landing splash (first visit of the session only).
 * The "SEGULA Technologies · Powered by MATRA" logo is composed in two beats on black:
 * the three circles of the isotype appear one by one (SVG, at their exact position
 * inside the 727×245 logo), then the PNG wordmark fades in clipped 20 % from the left so
 * the isotype is not duplicated. Everything fades out at 3300ms; the node is removed at
 * 4000ms by src/scripts/splash.ts. Mount it as the FIRST child of <body>
 * (Base.astro `slot="splash"`), only in index.astro.
 */
---

<div class="splash" data-splash aria-hidden="true">
  <div class="splash__stage">
    <svg viewBox="0 0 727 245" fill="#FFFFFF" aria-hidden="true">
      <circle cx="37.5" cy="41" r="29"></circle>
      <circle cx="109" cy="41" r="29"></circle>
      <circle cx="74.5" cy="101.5" r="29"></circle>
    </svg>
    <img
      src="/assets/segula-logo-powered-by-matra-white.png"
      alt=""
      width="727"
      height="245"
      decoding="async"
      fetchpriority="high"
    />
  </div>
</div>

<script>
  import '../scripts/splash';
</script>

<style>
  @keyframes splash-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes splash-out {
    from { opacity: 1; }
    to { opacity: 0; visibility: hidden; }
  }

  .splash {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: #000;
    display: grid;
    place-items: center;
    pointer-events: none; /* never blocks clicks */
    animation: splash-out 700ms cubic-bezier(0.2, 0.8, 0.2, 1) 3300ms both;
  }
  .splash__stage {
    position: relative;
    width: min(727px, 80vw);
    aspect-ratio: 727 / 245; /* same ratio as the PNG */
  }
  .splash__stage svg,
  .splash__stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Circles: appear sequentially and STAY visible */
  .splash__stage circle {
    opacity: 0;
    animation: splash-fade-in 600ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .splash__stage circle:nth-child(1) { animation-delay: 200ms; }
  .splash__stage circle:nth-child(2) { animation-delay: 650ms; }
  .splash__stage circle:nth-child(3) { animation-delay: 1100ms; }
  /* Wordmark: the PNG fades in, clipped 20 % from the left so its isotype does not
     overlap the SVG circles */
  .splash__stage img {
    opacity: 0;
    clip-path: inset(0 0 0 20%);
    animation: splash-fade-in 900ms cubic-bezier(0.2, 0.8, 0.2, 1) 1900ms both;
  }
  @media (prefers-reduced-motion: reduce) {
    .splash {
      animation-duration: 300ms;
      animation-delay: 400ms;
    }
    .splash__stage circle,
    .splash__stage img {
      animation: none;
      opacity: 1;
    }
  }
</style>
