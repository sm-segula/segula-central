---
/**
 * Landing splash: three circles appear in sequence, then the logo; the whole layer
 * fades out at 3300ms and is removed from the DOM at 4000ms. Shown once per browser
 * session (sessionStorage). Mirrors the prototype timings and SVG exactly.
 */
---

<div class="splash" data-splash aria-hidden="true">
  <div class="frame">
    <svg viewBox="0 0 727 245" fill="#FFFFFF" aria-hidden="true">
      <circle cx="37.5" cy="41" r="29"></circle>
      <circle cx="109" cy="41" r="29"></circle>
      <circle cx="74.5" cy="101.5" r="29"></circle>
    </svg>
    <img src="/assets/segula-logo-powered-by-matra-white.png" alt="" width="727" height="245" />
  </div>
</div>

<script is:inline>
  (function () {
    var splash = document.querySelector('[data-splash]');
    if (!splash) return;
    var KEY = 'sc-splash-seen';
    var seen = false;
    try {
      seen = sessionStorage.getItem(KEY) === '1';
      if (!seen) sessionStorage.setItem(KEY, '1');
    } catch (e) { /* storage unavailable: show the splash anyway */ }
    if (seen) { splash.remove(); return; }
    setTimeout(function () { splash.remove(); }, 4000);
  })();
</script>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: #000;
    display: grid;
    place-items: center;
    animation: sc-splash-out 700ms cubic-bezier(0.2, 0.8, 0.2, 1) 3300ms both;
    pointer-events: none;
  }
  /* Without JavaScript the layer would never be removed. */
  html:not(.js) .splash { display: none; }
  .frame {
    position: relative;
    width: min(727px, 80vw);
    aspect-ratio: 727 / 245;
  }
  .splash svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .splash circle {
    opacity: 0;
    animation: sc-fade-in 600ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .splash circle:nth-child(1) { animation-delay: 200ms; }
  .splash circle:nth-child(2) { animation-delay: 650ms; }
  .splash circle:nth-child(3) { animation-delay: 1100ms; }
  .splash img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    clip-path: inset(0 0 0 20%);
    animation: sc-fade-in 900ms cubic-bezier(0.2, 0.8, 0.2, 1) 1900ms both;
  }
  @media (prefers-reduced-motion: reduce) {
    .splash {
      animation-duration: 300ms;
      animation-delay: 400ms;
    }
    .splash circle,
    .splash img {
      animation: none;
      opacity: 1;
    }
  }
</style>
