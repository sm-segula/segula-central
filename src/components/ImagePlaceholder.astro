---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Stand-in for the prototype's <image-slot>.
 * - Without `src`: a `--surface-panel` box with the placeholder caption.
 * - With `src` as an imported asset (ImageMetadata): optimized <Image>.
 * - With `src` as a string (e.g. "/assets/foto.jpg"): plain <img>.
 * Always `object-fit: cover`, filling its container (set width/height on the parent
 * or pass `style`).
 */
interface Props {
  src?: string | ImageMetadata;
  alt?: string;
  placeholder?: string;
  radius?: number;
  /** Output width for optimized assets. */
  width?: number;
  /** Output height for optimized assets (crops with fit: cover). */
  height?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
  style?: string;
}

const {
  src,
  alt = '',
  placeholder = 'Imagen',
  radius = 12,
  width,
  height,
  loading = 'lazy',
  class: cls,
  style = '',
} = Astro.props;

const inline = `border-radius:${radius}px;${style}`;
const isAsset = typeof src === 'object' && src !== null;
---

{
  isAsset ? (
    <Image
      class:list={['img', cls]}
      src={src as ImageMetadata}
      alt={alt}
      width={width ?? 1400}
      height={height}
      loading={loading}
      style={inline}
    />
  ) : src ? (
    <img class:list={['img', cls]} src={src as string} alt={alt} width={width} height={height} loading={loading} style={inline} />
  ) : (
    <div class:list={['ph', cls]} aria-hidden="true" style={inline}>
      <span>{placeholder}</span>
    </div>
  )
}

<style>
  .img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ph {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 16px;
    box-sizing: border-box;
    background: var(--surface-panel);
    color: var(--text-muted);
    font: 300 13px/1.3 var(--font-sans);
    text-align: center;
    user-select: none;
  }
</style>
