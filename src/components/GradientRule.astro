---
interface Props {
  width?: number;
  height?: number;
  class?: string;
}
const { width = 160, height = 6, class: cls, ...rest } = Astro.props;
---

<span class:list={['rule', cls]} aria-hidden="true" style={`width:${width}px;height:${height}px`} {...rest}></span>

<style>
  .rule {
    display: block;
    flex: none;
    border-radius: var(--radius-full);
    background: var(--gradient-brand);
  }
</style>
