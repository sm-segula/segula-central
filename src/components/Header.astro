---
import { Search, Menu, X, ChevronDown } from 'lucide-astro';
import { NAV, hrefFor } from '../data/nav';

interface Props {
  menuTrigger?: 'hover' | 'click';
}
const { menuTrigger = 'hover' } = Astro.props;
---

<header data-topbar class="topbar">
  <div class="bar">
    <a href="/" class="logo" aria-label="SEGULA Central, inicio">
      <img
        src="/assets/segula-logo-powered-by-matra-white.png"
        alt="SEGULA Technologies, Powered by MATRA"
        width="727"
        height="245"
      />
    </a>

    <nav data-nav data-menu-trigger={menuTrigger} class="nav" aria-label="Principal">
      {NAV.map((item) => (
        <div class="nav-item" data-nav-item>
          {item.children ? (
            <>
              <button type="button" data-navlink class="navlink" aria-expanded="false" aria-haspopup="true">
                <span>{item.label}</span><span aria-hidden="true">{item.label}</span>
              </button>
              <div class="mega" data-megamenu hidden>
                <div class="mega-panel">
                  {item.children.map((label) => (
                    <a href={hrefFor(label)} class="mega-link">{label}</a>
                  ))}
                </div>
              </div>
            </>
          ) : (
            <a href={item.href ?? hrefFor(item.label)} data-navlink class="navlink">
              <span>{item.label}</span><span aria-hidden="true">{item.label}</span>
            </a>
          )}
        </div>
      ))}
    </nav>

    <label class="search">
      <Search size={18} stroke-width={1.5} aria-hidden="true" class="search-icon" />
      <input type="search" placeholder="Buscar" aria-label="Buscar en SEGULA Central" />
    </label>

    <button
      type="button"
      class="burger"
      data-burger
      aria-label="Abrir o cerrar menú"
      aria-expanded="false"
      aria-controls="sc-mobile-menu"
    >
      <X size={20} stroke-width={1.5} aria-hidden="true" data-icon-close hidden />
      <Menu size={20} stroke-width={1.5} aria-hidden="true" data-icon-open />
    </button>
  </div>
</header>

<div id="sc-mobile-menu" class="mobile" data-mobile-menu hidden>
  <label class="mobile-search">
    <Search size={18} stroke-width={1.5} aria-hidden="true" class="search-icon" />
    <input type="search" placeholder="Buscar" aria-label="Buscar en SEGULA Central" />
  </label>
  <div class="mobile-list">
    {NAV.map((item) => (
      <div class="acc" data-acc>
        {item.children ? (
          <>
            <button type="button" class="acc-btn" data-acc-btn aria-expanded="false">
              {item.label}
              <ChevronDown size={18} stroke-width={1.5} aria-hidden="true" class="acc-chev" />
            </button>
            <div class="acc-panel" data-acc-panel hidden>
              {item.children.map((label) => (
                <a href={hrefFor(label)} class="acc-link" data-mobile-leaf>{label}</a>
              ))}
            </div>
          </>
        ) : (
          <a href={item.href ?? hrefFor(item.label)} class="acc-btn" data-mobile-leaf>{item.label}</a>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    transition: transform 400ms var(--ease-out-expo), opacity 300ms var(--ease-standard);
    background: rgba(10, 18, 32, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .bar {
    max-width: 1312px;
    margin: 0 auto;
    height: 72px;
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 32px);
    padding-left: clamp(24px, 4.4vw, 64px);
    padding-right: clamp(24px, 4.4vw, 64px);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex: none;
    min-width: 0;
  }
  .logo:hover { text-decoration: none; }
  .logo img {
    display: block;
    height: 40px;
    width: auto;
    max-width: none;
    object-fit: contain;
  }

  /* Desktop nav */
  .nav {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
    flex: none;
  }
  .nav-item { position: relative; }
  .navlink {
    position: relative;
    display: inline-grid;
    place-items: center;
    height: 40px;
    padding: 0 clamp(8px, 0.9vw, 14px);
    border: 0;
    background: transparent;
    font: 300 14px/1 var(--font-sans);
    letter-spacing: 0.01em;
    cursor: pointer;
    border-radius: var(--radius-sm);
    color: #FFFFFF;
    text-decoration: none;
  }
  .navlink:hover { text-decoration: none; color: #FFFFFF; }
  .navlink > span {
    grid-area: 1 / 1;
    transition: opacity 280ms var(--ease-card);
    white-space: nowrap;
  }
  .navlink > span:first-child { font-weight: 300; color: #FFFFFF; }
  .navlink > span:last-child {
    font-weight: 600;
    opacity: 0;
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .navlink:hover > span:first-child,
  .navlink:focus-visible > span:first-child { opacity: 0; }
  .navlink:hover > span:last-child,
  .navlink:focus-visible > span:last-child { opacity: 1; }

  .mega {
    position: absolute;
    top: 100%;
    left: 0;
    padding-top: 6px;
    z-index: 60;
  }
  .mega-panel {
    min-width: 264px;
    background: var(--surface-panel);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-dark);
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    animation: sc-menu 250ms var(--ease-out-expo) both;
  }
  .mega-link {
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    color: #FFFFFF;
    font: 300 15px/1 var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 200ms var(--ease-standard);
  }
  .mega-link:hover {
    background: var(--color-selected);
    color: #FFFFFF;
    text-decoration: none;
  }

  /* Search pill */
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 14px;
    border-radius: var(--radius-full);
    background: var(--surface-panel);
    color: var(--text-muted);
    flex: 0 1 200px;
    min-width: 40px;
    overflow: hidden;
    box-sizing: border-box;
    transition: background-color 200ms var(--ease-standard);
  }
  .search:hover { background: var(--surface-card); }
  .search-icon { flex: none; }
  .search input,
  .mobile-search input {
    flex: 1 1 0;
    min-width: 0;
    width: 100%;
    border: 0;
    outline: none;
    background: transparent;
    color: #FFFFFF;
    font: 300 14px/1 var(--font-sans);
    padding: 0;
  }
  .search input:focus-visible,
  .mobile-search input:focus-visible { box-shadow: none; }

  /* Burger */
  .burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--surface-panel);
    color: #FFFFFF;
    cursor: pointer;
    flex: none;
    padding: 0;
  }
  .burger svg[hidden] { display: none; }

  /* Mobile panel */
  .mobile {
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 45;
    box-sizing: border-box;
    background: var(--bg-base);
    overflow: auto;
    padding: 24px clamp(24px, 4.4vw, 64px) 64px;
    animation: sc-menu 250ms var(--ease-out-expo) both;
  }
  .mobile[hidden] { display: none; }
  .mobile-search {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 16px;
    border-radius: var(--radius-full);
    background: var(--surface-panel);
    color: var(--text-muted);
    margin-bottom: 24px;
  }
  .mobile-search input { font: 300 16px/1 var(--font-sans); }
  .mobile-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .acc {
    background: var(--surface-card);
    border-radius: var(--radius-md);
    padding: 8px;
  }
  .acc-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 48px;
    padding: 0 12px;
    border: 0;
    background: transparent;
    color: #FFFFFF;
    font: 500 16px/1 var(--font-sans);
    cursor: pointer;
    border-radius: var(--radius-sm);
    text-align: left;
    text-decoration: none;
    box-sizing: border-box;
  }
  .acc-btn:hover { color: #FFFFFF; text-decoration: none; }
  .acc-chev { flex: none; color: var(--text-muted); }
  .acc-panel {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 4px 0 4px;
    animation: sc-menu 250ms var(--ease-out-expo) both;
  }
  .acc-panel[hidden] { display: none; }
  .acc-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font: 300 15px/1.3 var(--font-sans);
    text-decoration: none;
  }
  .acc-link:hover {
    background: var(--color-selected);
    color: #FFFFFF;
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .navlink > span { transition: none; }
  }
  @media (max-width: 1024px) {
    .nav { display: none; }
    .burger { display: inline-flex; }
  }
  @media (max-width: 640px) {
    .search { display: none; }
  }
</style>
