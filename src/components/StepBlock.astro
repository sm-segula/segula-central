---
import type { ImageMetadata } from 'astro';
import ImagePlaceholder from './ImagePlaceholder.astro';

/**
 * Numbered step, image + text alternating on a 12-column grid (same geometry as NewsBlock).
 * Number: 300 clamp(56px,6vw,88px) lightblue · title: 400 clamp(26px,2.4vw,34px)/1.2 ·
 * text: 300 clamp(17px,1.3vw,20px)/1.55 muted. Buttons go in the default slot.
 */
interface Props {
  number: string;
  title: string;
  text?: string;
  imageSide?: 'left' | 'right';
  imageHeight?: number;
  src?: string | ImageMetadata;
  alt?: string;
  placeholder?: string;
  class?: string;
}

const {
  number,
  title,
  text,
  imageSide = 'left',
  imageHeight = 360,
  src,
  alt,
  placeholder,
  class: cls,
  ...rest
} = Astro.props;
---

<article class:list={['step', `step--${imageSide}`, cls]} style={`--step-h:${imageHeight}px`} {...rest}>
  <div class="media" data-reveal>
    <ImagePlaceholder
      src={src}
      alt={alt ?? title}
      placeholder={placeholder ?? `Imagen · ${title}`}
      radius={20}
      width={1380}
      height={Math.round(imageHeight * 2)}
    />
  </div>
  <div class="body" data-reveal data-reveal-delay="90">
    <span class="number" aria-hidden="true">{number}</span>
    <h3 class="title">{title}</h3>
    {text && <p class="text">{text}</p>}
    <slot />
  </div>
</article>

<style>
  .step {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: center;
  }
  .media {
    grid-row: 1;
    height: var(--step-h);
    min-width: 0;
  }
  .body {
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
  }
  .step--left .media { grid-column: 1 / span 7; }
  .step--left .body { grid-column: 9 / span 4; }
  .step--right .media { grid-column: 6 / span 7; }
  .step--right .body { grid-column: 1 / span 4; }

  .number {
    font: 300 clamp(56px, 6vw, 88px) / 1 var(--font-sans);
    color: var(--brand-lightblue);
    letter-spacing: -0.02em;
  }
  .title {
    margin: 0;
    font: 400 clamp(26px, 2.4vw, 34px) / 1.2 var(--font-sans);
    color: #FFFFFF;
    text-wrap: balance;
  }
  .text {
    margin: 0;
    font: 300 clamp(17px, 1.3vw, 20px) / 1.55 var(--font-sans);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  @media (max-width: 1024px) {
    .step { grid-template-columns: minmax(0, 1fr); }
    /* Same specificity as the desktop placement rules so the reset wins. */
    .step--left .media,
    .step--left .body,
    .step--right .media,
    .step--right .body {
      grid-column: auto;
      grid-row: auto;
    }
    .media { order: -1; height: 320px; }
  }
  @media (max-width: 640px) {
    .media { height: 240px; }
  }
</style>
