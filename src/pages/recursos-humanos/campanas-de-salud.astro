---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Card from '../../components/Card.astro';

interface Campaign {
  title: string;
  href: string;
  delay: number;
}
interface Year {
  year: string;
  label: string;
  current: boolean;
  items: Campaign[];
}

const years: Year[] = [
  {
    year: '2026',
    label: '1 campaña',
    current: true,
    items: [
      { title: 'Campaña de Vacunación Sarampión', href: 'https://drive.google.com/file/d/1anwFZR6yCR4Hf2E4BZXqJUCs1gMbzmMa/view?usp=drive_link', delay: 0 },
    ],
  },
  {
    year: '2025',
    label: '2 campañas',
    current: false,
    items: [
      { title: 'Campaña de Vacunación Influenza', href: 'https://drive.google.com/file/d/1erRcHtivuCnDoINb4a5UyQGZxZEgCIn0/view?usp=drive_link', delay: 0 },
      { title: 'Campaña de Valoración y Corrección de Agudeza Visual', href: 'https://drive.google.com/file/d/1vOxMyV3ilpA38ciMEL61mQL1ZN1zypiN/view?usp=drive_link', delay: 70 },
    ],
  },
];
---

<Base title="Campañas de salud">
  <PageHero tag="Recursos Humanos" before="Campañas de " kw="salud" kwColor="pink">
    <p class="tagline" data-reveal data-reveal-delay="210">Tu salud, nuestra mejor inversión.</p>
  </PageHero>

  {years.map((y, i) => (
    <section class:list={['year', { 'year--last': i === years.length - 1 }]} aria-labelledby={`year-${y.year}`}>
      <div class="year-head" data-reveal>
        <h2 id={`year-${y.year}`} class:list={['year-title', { 'year-title--current': y.current }]}>{y.year}</h2>
        <span class="sc-tag">{y.label}</span>
      </div>
      <div class="docs">
        {y.items.map((c) => (
          <Card
            class="doc"
            title={c.title}
            href={c.href}
            placeholder={`Imagen · ${c.title}`}
            imageHeight={260}
            titleSize="md"
            titleFlex="1 1 200px"
            revealDelay={c.delay}
          />
        ))}
      </div>
    </section>
  ))}
</Base>

<style>
  .tagline {
    margin: 0;
    font: 300 clamp(20px, 1.8vw, 26px) / 1.4 var(--font-sans);
    color: #FFFFFF;
    text-wrap: pretty;
  }
  .year {
    max-width: 1312px;
    margin: 0 auto;
    padding: 0 clamp(24px, 4.4vw, 64px) clamp(72px, 8vw, 112px);
  }
  .year--last { padding-bottom: clamp(112px, 12vw, 176px); }
  .year-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 32px;
  }
  .year-title {
    margin: 0;
    font: 300 clamp(40px, 4.4vw, 64px) / 1 var(--font-sans);
    letter-spacing: -0.03em;
    color: var(--text-muted);
  }
  .year-title--current { color: var(--brand-lightblue); }
  .docs {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
  }
  .doc { grid-column: span 4; }

  @media (max-width: 1024px) {
    .doc { grid-column: span 6; }
  }
  @media (max-width: 640px) {
    .tagline { font-size: 19px; }
    .doc { grid-column: span 12; }
  }
</style>
