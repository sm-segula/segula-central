---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import DirectorySearch, { type Team } from '../../islands/DirectorySearch';
import directorio from '../../data/directorio.json';

const teams: Team[] = directorio;
---

<Base title="Directorio">
  <PageHero tag="Recursos Humanos" before="Directorio " kw="corporativo" kwColor="pink" bottom="md" />

  <div class="directorio">
    <DirectorySearch client:load teams={teams} />
  </div>
  <div class="spacer" aria-hidden="true"></div>
</Base>

<style>
  .directorio :global(.dr-search),
  .directorio :global(.dr-group),
  .directorio :global(.dr-empty) {
    max-width: 1312px;
    margin: 0 auto;
    padding: 0 clamp(24px, 4.4vw, 64px) clamp(72px, 8vw, 112px);
  }
  .directorio :global(.dr-search) {
    padding-bottom: clamp(56px, 6vw, 80px);
  }
  .directorio :global(.dr-empty) {
    padding-bottom: clamp(112px, 12vw, 176px);
  }

  .directorio :global(.dr-toolbar) {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .directorio :global(.dr-pill) {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 52px;
    padding: 0 20px;
    border-radius: var(--radius-full);
    background: var(--surface-panel);
    color: var(--text-muted);
    flex: 1 1 320px;
    max-width: 560px;
    box-sizing: border-box;
    transition: background-color 200ms var(--ease-standard);
  }
  .directorio :global(.dr-pill:hover) {
    background: var(--surface-card);
  }
  .directorio :global(.dr-pill:focus-within) {
    box-shadow: var(--focus-glow);
  }
  .directorio :global(.dr-input) {
    flex: 1 1 0;
    min-width: 0;
    width: 100%;
    border: 0;
    outline: none;
    background: transparent;
    color: #FFFFFF;
    font: 300 16px/1 var(--font-sans);
    padding: 0;
  }
  .directorio :global(.dr-input:focus),
  .directorio :global(.dr-input:focus-visible) {
    box-shadow: none;
  }
  .directorio :global(.dr-count),
  .directorio :global(.dr-team-count) {
    font: var(--font-tag);
    letter-spacing: var(--type-tag-tracking);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .directorio :global(.dr-count) {
    white-space: nowrap;
  }

  .directorio :global(.dr-head) {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 32px;
  }
  .directorio :global(.dr-team) {
    margin: 0;
    font: 400 clamp(28px, 3vw, 40px) / 1.1 var(--font-sans);
    color: #FFFFFF;
  }
  .directorio :global(.dr-grid) {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
  }
  .directorio :global(.dr-card) {
    grid-column: span 4;
    background: var(--surface-card);
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
    transition:
      opacity var(--duration-slow) var(--ease-out-expo),
      transform var(--duration-slow) var(--ease-out-expo),
      box-shadow var(--duration-base) var(--ease-card),
      background-color var(--duration-base) var(--ease-card);
  }
  .directorio :global(.dr-card:hover) {
    box-shadow: var(--shadow-dark);
    background: var(--surface-panel);
  }
  .directorio :global(.dr-id) {
    display: flex;
    align-items: center;
    gap: 20px;
    min-width: 0;
  }
  /* Circular <image-slot> placeholder (same look as ImagePlaceholder). */
  .directorio :global(.dr-avatar) {
    width: 88px;
    height: 88px;
    flex: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
    background: var(--surface-panel);
    color: var(--text-muted);
    font: 300 13px/1.3 var(--font-sans);
    text-align: center;
    user-select: none;
  }
  .directorio :global(.dr-meta) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .directorio :global(.dr-name) {
    margin: 0;
    font: 400 clamp(20px, 1.7vw, 24px) / 1.2 var(--font-sans);
    color: var(--text-card-title);
    text-wrap: balance;
  }
  .directorio :global(.dr-role) {
    font: 300 15px/1.4 var(--font-sans);
    color: var(--text-muted);
    text-wrap: pretty;
  }
  .directorio :global(.dr-links) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .directorio :global(.dr-link) {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 40px;
    min-width: 0;
    color: #FFFFFF;
    font: 300 16px/1.3 var(--font-sans);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .directorio :global(.dr-link:hover) {
    color: var(--brand-lightblue);
    text-decoration: none;
  }
  .directorio :global(.dr-icon) {
    flex: none;
    color: var(--brand-lightblue);
  }
  .directorio :global(.dr-email) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .directorio :global(.dr-empty p) {
    margin: 0;
    font: 300 clamp(18px, 1.5vw, 22px) / 1.5 var(--font-sans);
    color: var(--text-muted);
  }

  .spacer {
    height: clamp(40px, 4vw, 64px);
  }

  @media (prefers-reduced-motion: reduce) {
    .directorio :global(.dr-card) {
      transition: none;
    }
  }
  @media (max-width: 1024px) {
    .directorio :global(.dr-card) {
      grid-column: span 6;
    }
  }
  @media (max-width: 640px) {
    .directorio :global(.dr-card) {
      grid-column: span 12;
    }
  }
</style>
