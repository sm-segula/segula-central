---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import RuleCard from '../../components/RuleCard.astro';
import Card from '../../components/Card.astro';
import Panel from '../../components/Panel.astro';
import Button from '../../components/Button.astro';
import type { ImageMetadata } from 'astro';
import guiaImg from '../../assets/viajes/guia-de-comprobacion-de-gastos.webp';
import casosImg from '../../assets/viajes/casos-excepcionales.webp';
import plazoImg from '../../assets/viajes/el-plazo-de-los-7-dias-habiles-y-3-dias-de-correccion.webp';
import cfdiImg from '../../assets/viajes/comprobacion-obligatoria-con-cfdi-4-0-valido.webp';
import nominaImg from '../../assets/viajes/prevencion-de-descuento-via-nomina-y-bloqueo-de-viajes.webp';

const MENDEL = 'https://mx.app.mendel.com/login';

interface Resource {
  title: string;
  text: string;
  items?: string[];
  href: string;
  cta: string;
  src?: ImageMetadata;
  placeholder: string;
  delay: number;
}

const resources: Resource[] = [
  {
    title: 'Guía de comprobación de gastos',
    text: 'Video paso a paso para asociar comprobantes fiscales XML y PDF en Mendel, dar seguimiento al estatus de tus transacciones y resolver tareas pendientes en la aplicación.',
    href: '#',
    cta: 'Ver video',
    src: guiaImg,
    placeholder: 'Video · Guía de comprobación de gastos',
    delay: 0,
  },
  {
    title: 'Calendario de reembolsos',
    text: 'Consulta las fechas de pago vía nómina para gastos extraordinarios pagados con recursos propios autorizados:',
    items: [
      'Aprobación del día 1 al 15 del mes: pago a más tardar el día 30 del mismo mes.',
      'Aprobación del día 16 al fin del mes: pago a más tardar el día 30 del mes siguiente.',
    ],
    href: '#',
    cta: 'Ver calendario',
    placeholder: 'Documento · Calendario de reembolsos',
    delay: 70,
  },
  {
    title: 'Casos excepcionales',
    text: 'Recuerda que en gastos al extranjero Finanzas revisará directamente el registro de comprobación para gastos (vouchers/recibos), viáticos en zonas remotas sin facturación electrónica y justificaciones por falta de CFDI con aprobación de Finanzas.',
    href: '#',
    cta: 'Ver documento',
    src: casosImg,
    placeholder: 'Documento · Casos excepcionales',
    delay: 140,
  },
];

const rules = [
  {
    number: '01',
    title: 'El plazo de los 7 días hábiles y 3 días de corrección',
    text: 'Es necesario vincular todos tus CFDI 4.0 y dejar tus gastos en estatus «Comprobado» dentro de los 7 días hábiles posteriores al fin de tu viaje. Si Finanzas detecta faltantes o inconsistencias, te notificará y contarás con 3 días hábiles adicionales para corregir e integrar la documentación en la plataforma.',
    src: plazoImg,
    placeholder: 'Imagen · El plazo de los 7 días hábiles y 3 días de corrección',
    delay: 0,
  },
  {
    number: '02',
    title: 'Comprobación obligatoria con CFDI 4.0 válido',
    text: 'Todo gasto realizado debe estar amparado por una factura electrónica CFDI 4.0 timbrada acorde a la información fiscal proporcionada por Finanzas para su comisión en específico. Subir la foto del ticket no es suficiente; los comprobantes no validados, extemporáneos o con conceptos no permitidos (como bebidas alcohólicas o gastos personales) se rechazarán automáticamente.',
    src: cfdiImg,
    placeholder: 'Imagen · Comprobación obligatoria con CFDI 4.0 válido',
    delay: 70,
  },
  {
    number: '03',
    title: 'Prevención de descuento vía nómina y bloqueo de viajes',
    text: 'La falta de comprobación en tiempo o el no corregir inconsistencias derivará en el descuento total o parcial vía nómina sobre los saldos no justificados, con aviso previo y con fundamento en el Art. 110, fracción I de la Ley Federal del Trabajo.',
    src: nominaImg,
    placeholder: 'Imagen · Prevención de descuento vía nómina y bloqueo de viajes',
    delay: 140,
  },
];
---

<Base title="Después de tu viaje">
  <PageHero tag="Viajes · Paso 3 de 3" kw="Después" after=" de tu viaje">
    <div class="hero-cta" data-reveal data-reveal-delay="210">
      <Button variant="primary" href={MENDEL}>Haz tu comprobación de viáticos</Button>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="recursos-title">
    <SectionHead tag="Documentos y guías" id="recursos-title">Recursos y políticas de cierre</SectionHead>
    <div class="grid">
      {resources.map((r) => (
        <Card
          class="doc"
          title={r.title}
          href={r.href}
          cta={r.cta}
          src={r.src}
          alt={r.title}
          placeholder={r.placeholder}
          imageHeight={260}
          titleFlex="1 1 180px"
          hover={false}
          revealDelay={r.delay}
        >
          <div class="doc-copy">
            <p class="doc-text">{r.text}</p>
            {r.items && (
              <ul class="doc-list">
                {r.items.map((it) => <li>{it}</li>)}
              </ul>
            )}
          </div>
        </Card>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="reglas-title">
    <SectionHead tag="Reglas de oro" id="reglas-title">Tres reglas después del viaje</SectionHead>
    <div class="grid">
      {rules.map((r) => (
        <RuleCard class="doc" number={r.number} title={r.title} text={r.text} src={r.src} alt={r.title} placeholder={r.placeholder} revealDelay={r.delay} />
      ))}
    </div>
  </section>

  <section class="section section--last" aria-labelledby="plazo-title">
    <Panel as="div" class="plazo">
      <div class="plazo-num">
        <span class="seven" aria-hidden="true">7</span>
        <span class="sc-tag">Días hábiles</span>
      </div>
      <div class="plazo-copy">
        <h2 id="plazo-title" class="plazo-title">Deja tus gastos en estatus «Comprobado» en Mendel dentro de los 7 días hábiles posteriores al fin de tu viaje.</h2>
        <Button variant="primary" href={MENDEL}>Haz tu comprobación de viáticos</Button>
      </div>
    </Panel>
  </section>
</Base>

<style>
  .hero-cta { align-self: flex-start; }

  .section {
    max-width: 1312px;
    margin: 0 auto;
    padding: 0 clamp(24px, 4.4vw, 64px) clamp(96px, 10vw, 144px);
  }
  .section--last { padding-bottom: clamp(112px, 12vw, 176px); }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
  }
  .doc { grid-column: span 4; }
  /* Prototype: the "Ver" / "FAQs" link is flex:none */
  .doc :global(.btn) { flex: none; }
  .doc-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0 8px 8px;
  }
  .doc-text {
    margin: 0;
    font: 300 16px / 1.5 var(--font-sans);
    color: var(--text-muted);
    text-wrap: pretty;
  }
  .doc-list {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font: 300 15px / 1.5 var(--font-sans);
    color: var(--text-muted);
  }

  /* "7 días hábiles" panel */
  .plazo {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
  }
  .plazo-num {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .seven {
    font: 300 clamp(96px, 12vw, 176px) / 1 var(--font-sans);
    color: var(--brand-pink);
    letter-spacing: -0.04em;
  }
  .plazo-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
  }
  .plazo-title {
    margin: 0;
    font: 400 clamp(24px, 2.6vw, 36px) / 1.25 var(--font-sans);
    color: #FFFFFF;
    text-wrap: balance;
  }

  @media (max-width: 1024px) {
    .doc { grid-column: span 6; }
    .plazo { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .doc { grid-column: span 12; }
  }
</style>
