---
import ArrowRight from 'lucide-astro/ArrowRight';
import ArrowUpRight from 'lucide-astro/ArrowUpRight';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import RuleCard from '../../components/RuleCard.astro';
import Panel from '../../components/Panel.astro';
import Button from '../../components/Button.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import { ROUTES } from '../../data/nav';
import agenciaImg from '../../assets/viajes/tu-acompanante-24-7.webp';
import pagoImg from '../../assets/viajes/pago-y-registro-diario-en-la-app-mendel.webp';
import exclusionImg from '../../assets/viajes/exclusion-estricta-de-gastos-no-permitidos.webp';
import protocoloImg from '../../assets/viajes/protocolo-ante-emergencias-y-extensiones-de-viaje.webp';
import tabuladorImg from '../../assets/viajes/tabulador-de-limites-y-criterios-de-validacion.webp';
import tipsImg from '../../assets/viajes/tips-de-uso-de-la-app-y-tarjeta-mendel.webp';

const EMERGENCY_MAIL = 'mailto:aazar@gate18.com.mx,operaciones@gate18.com.mx?cc=segula@gate18.mx';

const phones = [
  { label: '55 19 65 63 30', tel: '+525519656330' },
  { label: '55 10 53 32 40', tel: '+525510533240' },
];

const rules = [
  {
    number: '01',
    title: 'Pago y registro diario en la app Mendel',
    text: 'Paga todos tus gastos con la tarjeta corporativa Mendel (física o virtual). Captura cada gasto y sube la fotografía del ticket el mismo día en que realizas la compra desde la aplicación móvil. Solicita siempre la factura electrónica CFDI 4.0 emitida con los datos fiscales de la empresa.',
    src: pagoImg,
    placeholder: 'Imagen · Pago y registro diario en la app Mendel',
    delay: 0,
  },
  {
    number: '02',
    title: 'Exclusión estricta de gastos no permitidos',
    text: 'Queda estrictamente prohibida la compra de bebidas alcohólicas de cualquier tipo en consumos de alimento. No se aceptan facturas por gastos personales (ropa, medicamentos, artículos de higiene, recargas telefónicas o multas) ni el uso de transporte en categorías premium (Uber Black, Uber XL).',
    src: exclusionImg,
    placeholder: 'Imagen · Exclusión estricta de gastos no permitidos',
    delay: 70,
  },
  {
    number: '03',
    title: 'Protocolo ante emergencias y extensiones de viaje',
    text: 'Si requieres extender o modificar la duración de tu estancia, notifícalo a tu PMO: toda modificación se gestiona obligatoriamente como un viaje nuevo (requiere nuevo STRA y nuevo presupuesto en Mendel). En caso de falla, bloqueo o extravío de tu tarjeta física, bloquéala en la app, solicita a RH la activación de tu tarjeta virtual o contáctate de inmediato con Finanzas antes de efectuar pagos con recursos propios.',
    src: protocoloImg,
    placeholder: 'Imagen · Protocolo ante emergencias y extensiones de viaje',
    delay: 140,
  },
];
---

<Base title="Durante tu viaje">
  <PageHero tag="Viajes · Paso 2 de 3" kw="Durante" after=" tu viaje" />

  <section class="section" aria-labelledby="agencia-title">
    <Panel as="div" class="duo">
      <div class="duo-copy">
        <span class="sc-tag">Agencia de viajes</span>
        <h2 id="agencia-title" class="h2">Tu acompañante <span class="sc-kw--blue">24/7</span></h2>
        <p class="lead">Recuerda que para cualquier emergencia, cambio o imprevisto con vuelos, hospedaje o transporte durante tu viaje, la agencia Gate18 cuenta con un servicio de atención y apoyo continuo las 24 horas a través de los siguientes medios:</p>
        <ul class="contacts">
          <li class="contact">
            <span class="contact-label">Teléfonos de emergencia 24/7</span>
            <span class="contact-value">
              {phones.map((p, i) => (
                <>{i > 0 && ' | '}<a class="inline-link" href={`tel:${p.tel}`}>{p.label}</a></>
              ))}
            </span>
          </li>
          <li class="contact">
            <span class="contact-label">Correos de atención</span>
            <span class="contact-value">
              <a class="inline-link" href="mailto:aazar@gate18.com.mx">aazar@gate18.com.mx</a> y <a class="inline-link" href="mailto:operaciones@gate18.com.mx">operaciones@gate18.com.mx</a> (con copia obligatoria a <a class="inline-link" href="mailto:segula@gate18.mx">segula@gate18.mx</a>)
            </span>
          </li>
          <li class="contact">
            <span class="contact-label">Contactos de seguimiento interno</span>
            <span class="contact-value">Mariana Fonseca, Evelyn Abarca y Karina Hernández</span>
          </li>
        </ul>
        <Button variant="primary" href={EMERGENCY_MAIL}>Correo de emergencia</Button>
      </div>
      <div class="duo-media">
        <ImagePlaceholder src={agenciaImg} alt="Tu acompañante 24/7: tarjeta de contacto de la agencia Gate18" placeholder="Tarjeta de contacto · Agencia 24/7" radius={12} />
      </div>
    </Panel>
  </section>

  <section class="section" aria-labelledby="reglas-title">
    <SectionHead tag="Reglas de oro" id="reglas-title">Tres reglas durante el viaje</SectionHead>
    <div class="grid">
      {rules.map((r) => (
        <RuleCard class="rule" number={r.number} title={r.title} text={r.text} src={r.src} alt={r.title} placeholder={r.placeholder} revealDelay={r.delay} />
      ))}
    </div>
  </section>

  <section class="section" aria-label="Recursos y documentos adicionales">
    <span class="sc-tag recursos-tag">Recursos y documentos adicionales</span>
    <div class="grid">
      <article class="tile tile--half" data-reveal>
        <div class="tile-media">
          <ImagePlaceholder src={tabuladorImg} alt="Infografía: tabulador de límites y criterios de validación" placeholder="Infografía · Tabulador de límites" radius={12} />
        </div>
        <div class="tile-row">
          <div class="tile-copy">
            <h3 class="tile-title">Tabulador de límites y criterios de validación</h3>
            <p class="tile-text">Revisa los límites diarios autorizados por concepto (alimentos, hospedaje, transporte, peajes) y la diferenciación entre gastos personales y de la empresa.</p>
          </div>
        </div>
      </article>
      <article class="tile tile--half" data-reveal data-reveal-delay="70">
        <div class="tile-media">
          <ImagePlaceholder src={tipsImg} alt="Tips de uso de la app y tarjeta Mendel" placeholder="Imagen · Tips de uso de la app y tarjeta Mendel" radius={12} />
        </div>
        <div class="tile-row">
          <div class="tile-copy">
            <h3 class="tile-title">Tips de uso de la app y tarjeta Mendel</h3>
            <p class="tile-text">Revisa tus transacciones en tiempo real, consulta tu NIP y da seguimiento al estado de tus facturas. <strong>Recuerda:</strong> el registro de los tickets dentro de la aplicación no es una comprobación válida, necesitas completar el registro con la factura correspondiente.</p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section section--last" aria-label="Siguiente paso">
    <div class="grid">
      <a class="link-card link-card--faq" href={ROUTES['Centro de ayuda']} data-reveal>
        <div class="link-copy">
          <span class="sc-tag">¿Dudas?</span>
          <span class="faq-title">FAQs</span>
        </div>
        <ArrowUpRight size={28} stroke-width={1.5} aria-hidden="true" class="link-icon" />
      </a>
      <a class="link-card link-card--next" href={ROUTES['Después de tu viaje']} data-reveal data-reveal-delay="70">
        <div class="link-copy">
          <span class="sc-tag">Paso 3 de 3</span>
          <span class="next-title">Continúa tu proceso después de tu viaje</span>
        </div>
        <ArrowRight size={32} stroke-width={1.5} aria-hidden="true" class="link-icon" />
      </a>
    </div>
  </section>
</Base>

<style>
  .section {
    max-width: 1312px;
    margin: 0 auto;
    padding: 0 clamp(24px, 4.4vw, 64px) clamp(96px, 10vw, 144px);
  }
  .section--last { padding-bottom: clamp(112px, 12vw, 176px); }

  .h2 {
    margin: 0;
    font: 400 clamp(28px, 3vw, 40px) / 1.15 var(--font-sans);
    color: #FFFFFF;
    text-wrap: balance;
  }
  .lead {
    margin: 0;
    font: 300 clamp(17px, 1.4vw, 21px) / 1.55 var(--font-sans);
    color: #FFFFFF;
    text-wrap: pretty;
  }

  /* 24/7 panel */
  .duo {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
  }
  .duo-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    min-width: 0;
  }
  .duo-media {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  /* 24/7 contacts */
  .contacts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .contact {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .contact-label {
    font: 400 14px / 1.3 var(--font-sans);
    color: var(--text-muted);
  }
  .contact-value {
    font: 400 16px / 1.5 var(--font-sans);
    color: #FFFFFF;
    overflow-wrap: anywhere;
  }
  .inline-link {
    color: var(--brand-lightblue);
    text-decoration: none;
  }
  .inline-link:hover { color: #FFFFFF; }

  .recursos-tag {
    display: inline-block;
    margin-bottom: 24px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
  }
  .rule { grid-column: span 4; }

  /* Billing / expenses / tips tiles (no hover) */
  .tile {
    background: var(--surface-card);
    border-radius: var(--radius-lg);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
  .tile--half { grid-column: span 6; }
  .tile--full { grid-column: span 12; }
  .tile-media {
    width: 100%;
    height: 300px;
  }
  .tile-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding: 0 8px 8px;
    flex-wrap: wrap;
  }
  .tile-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    flex: 1 1 240px;
  }
  .tile-title {
    margin: 0;
    font: 400 clamp(22px, 1.9vw, 26px) / 1.2 var(--font-sans);
    color: var(--text-card-title);
    text-wrap: balance;
  }
  .tile-text {
    margin: 0;
    font: 300 16px / 1.5 var(--font-sans);
    color: var(--text-muted);
    text-wrap: pretty;
  }
  .tile-row :global(.tile-btn) { flex: none; }

  /* FAQs + next step cards */
  .link-card {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    background: var(--surface-card);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: #FFFFFF;
    min-width: 0;
    transition:
      opacity var(--duration-slow) var(--ease-out-expo),
      transform var(--duration-slow) var(--ease-out-expo),
      box-shadow var(--duration-base) var(--ease-card),
      background-color var(--duration-base) var(--ease-card);
  }
  .link-card:hover {
    background: var(--surface-panel);
    box-shadow: var(--shadow-dark);
    color: #FFFFFF;
    text-decoration: none;
  }
  .link-card--faq {
    grid-column: span 4;
    flex-direction: column;
    padding: clamp(28px, 3vw, 40px);
  }
  .link-card--next {
    grid-column: span 8;
    align-items: center;
    flex-wrap: wrap;
    padding: clamp(28px, 3vw, 40px) clamp(28px, 4vw, 48px);
  }
  .link-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .faq-title {
    font: 400 clamp(22px, 2vw, 28px) / 1.2 var(--font-sans);
    color: #FFFFFF;
  }
  .next-title {
    font: 400 clamp(24px, 2.6vw, 36px) / 1.2 var(--font-sans);
    color: #FFFFFF;
    text-wrap: balance;
  }
  .link-card :global(.link-icon) {
    flex: none;
    color: var(--brand-lightblue);
  }

  @media (max-width: 1024px) {
    .duo { grid-template-columns: minmax(0, 1fr); }
    .rule { grid-column: span 6; }
  }
  @media (max-width: 640px) {
    .rule,
    .tile--half,
    .tile--full,
    .link-card--faq,
    .link-card--next { grid-column: span 12; }
    .tile-media { height: 220px; }
  }
</style>
